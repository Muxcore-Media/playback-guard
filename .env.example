# MUXCORE_MODULE_ID=playback-guard
# PLAYBACK_GUARD_DB_PATH=/var/lib/muxcore-playback-guard/guard.db
# PLAYBACK_GUARD_GRPC_ADDR=127.0.0.1:9561
# PLAYBACK_GUARD_MODULE_TOKEN=
# PLAYBACK_GUARD_NOTIFY_ON_VIOLATION=0
# PLAYBACK_GUARD_INACTIVITY_SWEEP_SEC=3600
# ERASURE_SWEEP_INTERVAL=5m
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Rule params (UpsertRule Params map):
# concurrent_streams: max_streams, action=terminate
# geo_restriction: mode=blocklist|allowlist, countries=US,CN, action=terminate
# simultaneous_locations: min_distance_km, action=terminate
# impossible_travel: max_speed_kmh, action=terminate
# device_velocity: window_hours, max_ips, action=terminate
# account_inactivity: inactivity_value, inactivity_unit=days|weeks|months
